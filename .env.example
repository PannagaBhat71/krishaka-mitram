# Krishaka Mitram - Production Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ===========================================
# REQUIRED IN PRODUCTION
# ===========================================

# Django secret key - generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-very-long-random-secret-key-here-min-50-chars

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (required when DEBUG=False)
# Example: ALLOWED_HOSTS=krishakamitram.com,www.krishakamitram.com
ALLOWED_HOSTS=your-domain.com

# Render.com automatically provides this - will be added to ALLOWED_HOSTS
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# ===========================================
# DATABASE (PostgreSQL in production)
# ===========================================

# Full PostgreSQL connection URL (Render provides this automatically)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://user:password@host:port/database

# ===========================================
# REDIS (Required for WebSocket chat)
# ===========================================

# Redis connection URL (Render provides this automatically)
# Format: redis://host:port/db
# REDIS_URL=redis://host:port/0

# ===========================================
# EMAIL (SMTP for production)
# ===========================================

# SMTP server settings
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# OPTIONAL SETTINGS
# ===========================================

# Time zone (default: UTC)
# TIME_ZONE=Asia/Kolkata

# Static files storage (default: WhiteNoise)
# STATICFILES_STORAGE=whitenoise.storage.CompressedManifestStaticFilesStorage

# ===========================================
# DEVELOPMENT OVERRIDES (uncomment for local dev)
# ===========================================

# DEBUG=True
# SECRET_KEY=django-insecure-dev-only-key-change-in-production
# REDIS_URL=redis://127.0.0.1:6380/0
# DATABASE_URL=sqlite:///db.sqlite3
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False